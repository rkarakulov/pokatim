APP_VERSION=latest
PUBLIC_HOST=pokatim.by
ADMIN_HOST=admin.pokatim.by
NODE_ENV=production
# пользователь приложения MongoDB (readWrite на БД pokatim); пароль — hex, без экранирования в URL
MONGO_URL=mongodb://pokatim:CHANGE_ME@mongo:27017/pokatim?replicaSet=rs0&authSource=pokatim
REDIS_URL=redis://redis:6379
TRUST_PROXY=1
JWT_SECRET=CHANGE_ME
EMAIL_TOKEN_SECRET=CHANGE_ME
SMTP_URL=smtp://CHANGE_ME:CHANGE_ME@smtp.example.com:587
MAIL_FROM=Покатим <no-reply@limedolphin.com>
APP_LINK_BASE=pokatim://
AGREEMENT_VERSION=CHANGE_ME
