# Шаблон .env стека на сервере (bootstrap.sh). Значения здесь — несекретные умолчания; @secret — ключ
# генерируется на сервере (openssl rand -hex 32) при первом появлении и больше не меняется.
# Существующие значения в .env сервера bootstrap не перезаписывает, недостающие ключи дописывает.
# PUBLIC_HOST, WEB_ORIGIN, APP_LINK_BASE, POKATIM_TAG выставляет каждый деплой (из DEV_PUBLIC_HOST и тега);
# MAIL_RELAY_RECIPIENTS — из секрета DEV_MAIL_RELAY_RECIPIENTS окружения dev, MAILPIT_RELAY_* — вычисляет bootstrap.
# MongoDB (Q1): root — только администрирование (deploy.sh, mongo-init.js), приложению — пользователь pokatim
# с readWrite на БД pokatim; keyfile набора — отдельный файл mongo-keyfile (bootstrap.sh), не здесь
MONGO_ROOT_PASSWORD=@secret
MONGO_PASSWORD=@secret
JWT_SECRET=@secret
EMAIL_TOKEN_SECRET=@secret
# пароль UI Mailpit (https://<хост>/mail/, пользователь dev); сменить — удалить строку в .env сервера и передеплоить
MAILPIT_UI_PASSWORD=@secret
# отправитель; домен проверяется в Amazon SES (relay ниже; для Gmail — адрес ящика, runbook «Почта»)
MAIL_FROM='Покатим dev <no-reply@limedolphin.com>'
# relay Mailpit → внешний SMTP (runbook «Почта»; умолчание — Amazon SES, временно — Gmail): письма разрешённым
# получателям уходят наружу, копия — в Mailpit. Хост и порт — умолчания ниже (STARTTLS обязателен); логин и пароль
# вписываются в .env сервера руками (латиница, цифры, . _ @ + / = -; можно в одинарных кавычках); пусто — relay
# выключен.
MAIL_RELAY_HOST=email-smtp.eu-north-1.amazonaws.com
MAIL_RELAY_PORT=587
MAIL_RELAY_USERNAME=
MAIL_RELAY_PASSWORD=
AGREEMENT_VERSION=2026-10-draft
TRUST_PROXY=1
# треки (ADR-0011): квота хранилища исходников (том trackfiles) и минимум свободного места общего диска, байт
TRACK_STORAGE_MAX_BYTES=2147483648
TRACK_STORAGE_MIN_FREE_BYTES=1073741824
# устройства через агрегатор Open Wearables (runbook «Устройства»): выключены по умолчанию — стенд стартует без
# ключей. Ключи вписывает владелец руками (не в git, не в чат); включение — DEVICES_ENABLED=true и деплой.
# OW_DOCKER_NETWORK — имя docker-сети стека OW: api/worker подключаются к ней (docker-compose.ow.yml); пусто — нет.
# OW_WEBHOOK_SECRET (whsec_…) — только если в OW включены исходящие вебхуки; пусто — работает pull.
DEVICES_ENABLED=false
OW_API_URL=
OW_API_KEY=
OW_WEBHOOK_SECRET=
OW_SHARED_INSTANCE=true
OW_DOCKER_NETWORK=
# прокси /ow/ на Open Wearables этого хоста (вебхуки Garmin, ADR-0011): http://127.0.0.1:<порт API OW>; пусто — нет
OW_PUBLIC_PROXY=
