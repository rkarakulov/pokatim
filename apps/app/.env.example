# Скопируйте в apps/app/.env. Только публичные значения: EXPO_PUBLIC_* попадают в бандл.
# Без переменной dev-сборка ходит на http://127.0.0.1:3000 — телефон по USB: adb reverse tcp:3000 tcp:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
# только native: адрес web-карточек для «Поделиться» (кофе-райды); без него кнопки нет, web берёт адрес страницы
# EXPO_PUBLIC_WEB_ORIGIN=http://127.0.0.1:8080

# Web-сервер (pnpm start:web читает этот .env). Серверный бандл берёт EXPO_PUBLIC_API_URL из окружения
# процесса во время запроса — он нужен и на сборке (build:web), и здесь.
PORT=8080
HOST=127.0.0.1
# серверные, без EXPO_PUBLIC_ (в бандл клиента не попадают): адрес API для loader-ов SSR
# (в docker — внутренний) и публичный адрес сайта для og:url; без WEB_ORIGIN og:url не выводится
API_INTERNAL_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:8080
