    "@rkarakulov/config": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/react-native": "^14.1.0",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "node scripts/copy-map-worker.ts && expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "node scripts/copy-map-worker.ts && expo export --platform web && node scripts/build-service-worker.ts",
    "build:web:dev": "node scripts/copy-map-worker.ts && expo export --platform web --dev --output-dir dist-dev",
    "start:web": "node --env-file-if-exists=.env server/main.ts",
    "e2e:web": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor",
    "build:preview": "eas build --profile preview --platform all",
    "build:testflight": "eas build --profile production --platform ios --auto-submit",
    "build:play-internal": "eas build --profile production --platform android --auto-submit"
  },
  "private": true,
  "description": "Универсальное приложение райдера pokatim (Expo: iOS, Android и web/PWA)"
}
