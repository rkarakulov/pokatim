NODE_ENV=development
PORT=3000
# replica set из pnpm infra:up (транзакции, outbox); directConnection — член набора объявлен как 127.0.0.1:27017
MONGO_URL=mongodb://127.0.0.1:27017/pokatim?directConnection=true
REDIS_URL=redis://127.0.0.1:6379
# сколько прокси доверять в X-Forwarded-For: 0 — нет; за обратным прокси в проде — 1
TRUST_PROXY=0
# секреты: случайные строки не короче 32 символов, например `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_random_string_at_least_32_chars
EMAIL_TOKEN_SECRET=CHANGE_ME_random_string_at_least_32_chars
# CORS для web в dev (expo start — :8081, pnpm start:web — :8080, pnpm e2e:web — :8090/:8091); пусто — выключен
# (прод: один origin за прокси)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://127.0.0.1:8080,http://127.0.0.1:8090,http://127.0.0.1:8091
# dev: Mailpit из pnpm infra:up, письма — http://127.0.0.1:8025
SMTP_URL=smtp://127.0.0.1:1025
# в кавычках: «#» без них — начало комментария; обратная кавычка — если в названии есть «'» (process.loadEnvFile
# не знает экранирования, обратной кавычки и перевода строки в project_name нет — валидатор copier.yml)
MAIL_FROM='Покатим <no-reply@limedolphin.com>'
# база ссылок в письмах: Expo Go — exp://<LAN-IP>:8081/--/ , сборки — pokatim://
APP_LINK_BASE=exp://127.0.0.1:8081/--/
AGREEMENT_VERSION=2026-10-draft
