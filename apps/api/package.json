{
  "name": "@pokatim/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS модульный монолит: HTTP API (main.ts) и воркер очередей (worker.ts)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=@pokatim/source src/db/migrate.ts",
    "panel": "tsx --conditions=@pokatim/source src/cli/panel.ts",
    "preview:story-cards": "tsx --conditions=@pokatim/source scripts/story-card-preview.ts"
  },
  "dependencies": {
    "@expo-google-fonts/golos-text": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/roboto-condensed": "^0.4.2",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@node-rs/argon2": "^2.2.2",
    "@pokatim/contracts": "workspace:*",
    "@pokatim/design-tokens": "workspace:*",
    "@pokatim/i18n": "workspace:*",
    "@pokatim/route-view": "workspace:*",
    "@pokatim/tracks": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@rkarakulov/api-kit": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "jose": "^6.2.13",
    "mongodb": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "satori": "^0.63.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "catalog:",
    "@rkarakulov/config": "catalog:",
    "@rkarakulov/test-kit": "catalog:",
    "@swc/cli": "^0.8.0",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
