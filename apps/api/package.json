{
  "name": "@pokatim/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS модульный монолит: HTTP API (main.ts) и воркер очередей (worker.ts)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@pokatim/contracts": "workspace:*",
    "@pokatim/tracks": "workspace:*",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@node-rs/argon2": "^2.2.2",
    "@rkarakulov/api-kit": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "jose": "^6.2.13",
    "mongodb": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "catalog:",
    "@rkarakulov/config": "catalog:",
    "@rkarakulov/test-kit": "catalog:",
    "@swc/cli": "^0.8.0",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
