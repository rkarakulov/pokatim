{
  "extends": "@rkarakulov/config/tsconfig.library.json",
  // Только проверка типов (сборка — SWC в CommonJS). Пакеты базы @rkarakulov/* — ESM с subpath-входами
  // (/core, /mongo): Bundler — одни декларации (import) для кода api и пакетов базы.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // исходники workspace-пакетов (@pokatim/*) — без сборки dist
    "customConditions": ["@pokatim/source"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "dist"
  },
  "include": ["src", "test", "vitest.config.mts"]
}
