{
  "name": "pokatim",
  "private": true,
  "author": "Roman Karakulov",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:worker": "turbo run dev:worker --filter=@pokatim/api",
    "build": "turbo run build",
    "build:web": "turbo run build:web",
    "e2e:web": "turbo run e2e:web --env-mode=loose",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm format:check && pnpm lint && pnpm arch:check && pnpm typecheck && pnpm test",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@rkarakulov/config": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
