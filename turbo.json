{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["ADMIN_BASE"]
    },
    "build:web": {
      "cache": false,
      "env": ["EXPO_PUBLIC_*"]
    },
    "e2e:web": {
      "dependsOn": ["build:web"],
      "cache": false,
      "env": ["EXPO_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "env": ["MONGO_URL_TEST", "REDIS_URL_TEST"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:worker": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
