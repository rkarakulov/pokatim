{
  "name": "@pokatim/tracks",
  "version": "0.0.0",
  "private": true,
  "description": "Разбор FIT/GPX (треки) и GPX/KML/KMZ/TCX (маршруты), экспорт маршрута, геометрия треков",
  "type": "module",
  "exports": {
    ".": {
      "@pokatim/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parse": {
      "@pokatim/source": "./src/parse.ts",
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.218.0",
    "fast-xml-parser": "5.11.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rkarakulov/config": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
